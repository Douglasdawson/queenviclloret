# --- Core ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Neon / Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Sessions ---
# openssl rand -hex 32
SESSION_SECRET=

# --- Initial admin seed (db:seed) ---
SEED_OWNER_EMAIL=owner@queenviclloret.es
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Queen Vic Owner

# --- AI provider (noop until enabled) ---
AI_PROVIDER=noop
ANTHROPIC_API_KEY=

# --- Email provider ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Queen Vic <hello@queenviclloret.es>"
RESEND_WEBHOOK_SECRET=

# --- WhatsApp provider (Meta Cloud API) ---
WHATSAPP_PROVIDER=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Fixtures feed (auto-import of matches) ---
FIXTURES_PROVIDER=thesportsdb
FIXTURES_API_KEY=
FIXTURES_AUTO_PUBLISH=false

# --- Analytics & Search Console (optional) ---
# GA4 only loads in production, after the visitor accepts analytics cookies,
# and never on /admin. GSC_VERIFICATION renders the google-site-verification
# meta tag on every page (set it before clicking "Verify" in Search Console).
GA4_MEASUREMENT_ID=
GSC_VERIFICATION=
